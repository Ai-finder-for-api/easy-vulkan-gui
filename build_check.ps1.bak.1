$ErrorActionPreference = 'Continue'
$root = 'C:\Users\Yash\evg-work\evg'
$vcvars = 'C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat'
$cm = 'C:\Program Files\CMake\bin\cmake.exe'
$ct = 'C:\Program Files\CMake\bin\ctest.exe'
$qt = 'C:\Qt\6.8.3\msvc2022_64'
$vk = 'C:\Users\yash\vcpkg\installed\x64-windows'
# the installed Windows SDK is 10.0.28000.0; vcvars may point at an older version that is no longer present
$sdk = 'C:\Program Files (x86)\Windows Kits\10'
$sdkv = '10.0.28000.0'
$env:PATH = "$qt\bin;$vk\bin;" + $env:PATH
$env:QT_PLUGIN_PATH = "$qt\plugins"
$fix = "set `"LIB=$sdk\Lib\$sdkv\um\x64;$sdk\Lib\$sdkv\ucrt\x64;%LIB%`" && set `"INCLUDE=$sdk\Include\$sdkv\ucrt;$sdk\Include\$sdkv\um;$sdk\Include\$sdkv\shared;%INCLUDE%`""
if (-not (Test-Path "$root\build-1\CMakeCache.txt")) {
  cmd /c "`"$vcvars`" >nul && $fix && cd /d `"$root`" && `"$cm`" -S . -B build-1 -G Ninja -DCMAKE_BUILD_TYPE=Release -DEVG_WITH_QT=ON -DEVG_WITH_EXR=ON -DCMAKE_PREFIX_PATH=`"$vk;$qt`" > $root\configure.log 2>&1"
  "configure exit: $LASTEXITCODE"
}
cmd /c "`"$vcvars`" >nul && $fix && cd /d `"$root`" && `"$cm`" --build build-1 --parallel 2 > $root\build1.log 2>&1"
"build exit: $LASTEXITCODE"
Select-String -Path "$root\build1.log" -Pattern 'error C|fatal|LNK' | Select-Object -First 20 | ForEach-Object { $_.Line }
cmd /c "`"$vcvars`" >nul && $fix && cd /d `"$root\build-1`" && `"$ct`" --output-on-failure > $root\ctest1.log 2>&1"
"ctest exit: $LASTEXITCODE"
Get-Content "$root\ctest1.log" | Select-Object -Last 30
